{
  "name": "deskbasket",
  "productName": "DeskBasket",
  "version": "1.4.1",
  "description": "桌面磨砂文件筐 ＋ 底部 Dock ＋ 实时天气（Electron 版，与 token 监测同架构）",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64 --publish never",
    "make:icon": "python scripts/make_ico.py"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.cmchen.deskbasket",
    "productName": "DeskBasket",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        { "target": "dmg" },
        { "target": "zip" }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "DeskBasket <shi-tou1234@users.noreply.github.com>",
      "synopsis": "Desktop file baskets + dock"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskBasket",
      "artifactName": "DeskBasket-Setup-${version}.${ext}",
      "uninstallDisplayName": "DeskBasket 桌面文件筐"
    }
  }
}
